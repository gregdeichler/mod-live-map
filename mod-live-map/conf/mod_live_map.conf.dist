########################################
# Live Map - AzerothCore Module Config
# Optimized for 1200+ bots
########################################

[LiveMap]

LiveMap.Enable = 1

# Maps: 0=EK, 1=Kalimdor, 530=Outland, 571=Northrend, all=track all
LiveMap.MapFilter = 0

# Update intervals
LiveMap.UpdateIntervalMs = 1000
LiveMap.BotUpdateIntervalMs = 3000
LiveMap.BatchSize = 200

# ---- Bot handling (1200 bots) ----
LiveMap.TrackBots = 1
LiveMap.TrackBotsOnly = 0

# ---- Redis (recommended) ----
LiveMap.UseRedis = 1
LiveMap.RedisHost = 127.0.0.1
LiveMap.RedisPort = 6379

# ---- HTTP batch (optional, no redis) ----
LiveMap.UseHttp = 0
LiveMap.ApiUrl = http://127.0.0.1:8000/api/positions/batch
LiveMap.Secret = local-secret-123

# ---- GM handling ----
LiveMap.TrackGM = 0
LiveMap.TrackGMInvisible = 0
